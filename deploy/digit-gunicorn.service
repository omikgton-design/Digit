[Unit]
Description=Digit Django Gunicorn service
After=network.target mysql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/home/digit/backend
Environment="PATH=/home/digit/.venv/bin"
Environment="HOME=/tmp"
ExecStart=/home/digit/.venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8005 digit.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
